<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only (never merged into release) — see network_security_config.xml's
         own doc comment: permits plain HTTP to localhost/127.0.0.1/10.0.2.2 for
         local backend/Supabase testing (docs/phase-5-release-validation-report.md). -->
    <application android:networkSecurityConfig="@xml/network_security_config">
    </application>
</manifest>
