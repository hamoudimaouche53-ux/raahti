# RAHATI API Backend — environment variables (ADR-0005 Supabase, ADR-0009 Auth).
# Copy to .env for local development. Never commit a real .env (see root .gitignore).

NODE_ENV=development
PORT=3000

# Supabase-provisioned PostgreSQL (ADR-0004, ADR-0005). Prisma connection string.
DATABASE_URL="postgresql://postgres:password@localhost:5432/raahti?schema=public"

# Supabase project base URL (Auth/Storage/Realtime clients).
SUPABASE_URL="https://your-project.supabase.co"

# JWT verification (Security Architecture §1, ADR-0009). Exactly one of the two
# strategies below is used at runtime, selected by which var is present:
#   - SUPABASE_JWT_JWKS_URL: asymmetric (RS256/ES256) verification via remote JWKS
#     (current Supabase default for new projects).
#   - SUPABASE_JWT_SECRET: symmetric (HS256) verification via shared secret
#     (legacy Supabase projects). Never commit a real value.
SUPABASE_JWT_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_SECRET=""

# CORS allowlist (Security Architecture §5) — comma-separated origins for web/dashboards.
# Mobile app is exempt (native HTTP, not a browser origin).
CORS_ALLOWED_ORIGINS="https://raahti.dz,https://ops.raahti.dz,https://sponsors.raahti.dz"

# OSRM routing engine base URL (RoutingModule — in-app walking navigation). Defaults to
# the public OSRM demo server (no uptime/rate-limit SLA) when unset — set this to a
# self-hosted OSRM instance for production.
OSRM_BASE_URL="https://router.project-osrm.org"
