// RAHATI API Backend — Prisma schema.
// Canonical, generated-from, single definition of the relational schema, kept in
// 1:1 correspondence with the ERD (docs/erd/erd.md) per System Architecture §7.
// Built incrementally, module by module (Phase 4 Implementation Plan §7) — only
// entities needed by modules implemented so far are present.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// postgis: backs the Unsupported("geography(Point, 4326)") columns below
// (Station.position, ThirdPartyPlace.position) — System Architecture §7,
// ADR-0012. The other five (pgcrypto, uuid-ossp, pg_stat_statements, pg_net,
// supabase_vault) are not used by application code directly — they are
// installed into `public` by every Supabase project (local or hosted) as
// platform defaults, found during Release Validation's first-ever migration
// against a real (local) Supabase instance (docs/phase-5-release-validation-report.md):
// without declaring them, Prisma's drift detector treats them as unexpected
// changes and refuses to migrate. Declaring them here is a correctness fix
// for the canonical schema, not local-only — a real hosted Supabase project
// would hit the identical drift the first time `prisma migrate dev` ran
// against it. `previewFeatures = ["postgresqlExtensions"]` is required for
// Prisma to manage these in a migration.
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto, uuid_ossp(map: "uuid-ossp"), pg_stat_statements, pg_net, supabase_vault]
}

// --- Identity & Access bounded context (docs/architecture/domain-model.md §2) ---

/// ERD §3.7 — lookup table for the 4 fixed RBAC roles. Seeded, not user-editable via API.
model Role {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique // usager | operateur | sponsor | admin
  labelFr String @map("label_fr")
  labelAr String @map("label_ar")

  userRoles UserRole[]

  @@map("role")
}

/// ERD §3.6 — aggregate root of the Identity & Access bounded context (Domain Model §2).
/// Guest usage (no account) is represented by the absence of a User row entirely, per
/// FR-USR-01 — this table only ever holds account-holding users.
model User {
  /// Supabase Auth `sub` claim, not a DB-generated UUID — see ADR-0028. Always
  /// supplied explicitly by the application (JIT provisioning), never defaulted.
  id                         String                     @id @db.Uuid
  email                      String?                    @unique
  phone                      String?                    @unique
  preferredLanguage          PreferredLanguage          @default(fr) @map("preferred_language")
  diabeticVerificationStatus DiabeticVerificationStatus @default(none) @map("diabetic_verified_status")
  isActive                   Boolean                    @default(true) @map("is_active")
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")

  roles                    UserRole[]
  verificationDocuments    VerificationDocument[] @relation("VerificationDocumentOwner")
  reviewedVerificationDocs VerificationDocument[] @relation("VerificationDocumentReviewer")
  paymentMethods           PaymentMethod[]
  favorites                Favorite[]
  reviews                  Review[]
  notifications            Notification[]
  /// Sanctioned Access & Payment read/write dependency — same treatment as
  /// Notification.user (ERD §3.10).
  accessSessions           AccessSession[]
  transactions             Transaction[]

  @@map("user_account")
}

/// ERD §3.7 — grants a Role to a User, optionally scoped to a site (multi-site operateur, §4).
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  siteScope String?  @map("site_scope")
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, siteScope])
  @@map("user_role")
}

/// ERD §3.9 — data shape of the diabetic-verification submission workflow. Clinical
/// verification logic itself is out of scope (ADR-0010, deferred to health-partner
/// discussions) — this model only tracks submission/review state. Transition
/// invariant (pending -> approved/rejected, never backward) is enforced in
/// domain/entities/verification-document.entity.ts, not at the DB layer.
model VerificationDocument {
  id           String                   @id @default(uuid()) @db.Uuid
  userId       String                   @map("user_id") @db.Uuid
  documentType String                   @map("document_type") // diabetic_certificate
  storageRef   String                   @map("storage_ref")
  reviewStatus VerificationReviewStatus @default(pending) @map("review_status")
  reviewedBy   String?                  @map("reviewed_by") @db.Uuid
  submittedAt  DateTime                 @default(now()) @map("submitted_at")
  reviewedAt   DateTime?                @map("reviewed_at")

  user     User  @relation("VerificationDocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("VerificationDocumentReviewer", fields: [reviewedBy], references: [id])

  @@map("verification_document")
}

/// ERD entity referenced by RAH-DOC-005 §2.6 "moyens de paiement" — provider-tokenized
/// only (ADR-0014, NFR-SEC-03), never raw card data.
model PaymentMethod {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  methodType  String   @map("method_type") // card | mobile_wallet | subscription
  providerRef String   @map("provider_ref")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("payment_method")
}

/// ERD §3.16 — polymorphic over Station XOR ThirdPartyPlace (same pattern as Review,
/// ERD §3.15). The CHECK constraint enforcing "exactly one of stationId/
/// thirdPartyPlaceId is non-null" is not expressible in Prisma's schema language —
/// added via a hand-written SQL migration once a live database is available to run
/// `prisma migrate dev` against (none is provisioned yet — ADR-0016 hosting is still
/// Proposed). The same invariant is enforced in domain/entities/favorite.entity.ts
/// as the primary guard until then. `stationId`/`thirdPartyPlaceId` do not carry a
/// Prisma `@relation` yet — Station/ThirdPartyPlace models don't exist until the
/// facilities module (Phase 4 Implementation Plan §6 item 3) is implemented.
model Favorite {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  stationId         String?  @map("station_id") @db.Uuid
  thirdPartyPlaceId String?  @map("third_party_place_id") @db.Uuid
  notifyOnAvailable Boolean  @default(false) @map("notify_on_available")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevents a user from favoriting the same station (or same third-party place)
  // twice. Nullable-column unique indexes: Postgres treats each NULL as distinct,
  // so these correctly scope the dedup to same-kind favorites only.
  @@unique([userId, stationId])
  @@unique([userId, thirdPartyPlaceId])
  @@map("favorite")
}

/// ERD §3.15 — polymorphic over Station XOR ThirdPartyPlace, same pattern as
/// Favorite (§3.16). Not "owned" by either bounded-context module in the
/// domain sense — StationNetworkModule and ThirdPartyPlacesModule each keep
/// their own independent Review domain entity + repository port, both
/// backed by this single shared table (each scoped to its own non-null FK
/// column), per ADR-0029's "read composition only, writes stay in their
/// owning context" rule. The XOR CHECK constraint is not expressible in
/// Prisma's schema language — see prisma/README.md for the deferred SQL
/// migration (same situation as Favorite).
model Review {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  stationId         String?   @map("station_id") @db.Uuid
  thirdPartyPlaceId String?   @map("third_party_place_id") @db.Uuid
  rating            Int
  comment           String?
  createdAt         DateTime  @default(now()) @map("created_at")
  /// Additive gap-fill (EPIC-05 US-05.2 "manage my reviews", confirmed with the
  /// user 2026-08-06) — not in the original ERD §3.15, same "flagged, not
  /// silently added" treatment as IdempotencyKey / Notification's
  /// is_read/read_at. Nullable: never set until the first PATCH; `@updatedAt`
  /// auto-manages it on every subsequent `save()`.
  updatedAt         DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // stationId/thirdPartyPlaceId carry no `@relation` (see the module note
  // above), so Prisma's automatic FK-scalar indexing doesn't apply to them —
  // both are queried directly (rating-aggregation WHERE/JOIN/GROUP BY in
  // Facilities Pass 4's searchNearby and getRatingAggregate), so both need
  // an explicit index.
  @@index([stationId])
  @@index([thirdPartyPlaceId])
  @@map("review")
}

enum VerificationReviewStatus {
  pending
  approved
  rejected
}

// --- Station Network bounded context (docs/architecture/domain-model.md §3) ---

/// ERD §3.1 — aggregate root (Domain Model §3). `position` is PostGIS
/// geography(Point,4326) — Prisma's query builder can't express ST_DWithin/
/// ST_Distance (ADR-0012), so it's declared `Unsupported` for schema/migration
/// parity with the ERD and read/written exclusively via $queryRaw/$executeRaw
/// (see infrastructure/prisma-station.repository.ts).
model Station {
  id                 String                                @id @default(uuid()) @db.Uuid
  code               String                                @unique
  configuration      StationConfiguration
  position           Unsupported("geography(Point, 4326)")
  status             StationStatus
  cabinCapacity      Int                                   @map("cabin_capacity")
  tankCapacityLiters Int                                   @map("tank_capacity_liters")
  installedAt        DateTime                              @map("installed_at")
  createdAt          DateTime                              @default(now()) @map("created_at")
  updatedAt          DateTime                              @updatedAt @map("updated_at")

  cabins      Cabin[]
  slatokiTent SlatokiTent?

  /// Sanctioned Operations read dependency (module-dependency-diagram.md §3:
  /// `Ops -> StationNet` plain ✔). ERD §4 relationship table: Station -> Alert
  /// and Station -> MaintenanceIntervention are both 1:N RESTRICT ("preserve
  /// audit trail") — a Station with recorded alerts/interventions cannot be
  /// deleted. Same sanctioned-edge treatment as Notification.user (Notif -> Identity).
  alerts                   Alert[]
  maintenanceInterventions MaintenanceIntervention[]
  telemetryReadings        TelemetryReading[]

  /// ERD §5 "idx_station_status" — searchNearby (Facilities Pass 3) filters
  /// on status = 'active'; also supports FR-OPS-01 fleet filtering.
  @@index([status])
  @@map("station")
}

/// ERD §3.2 — entity within the Station aggregate.
model Cabin {
  id                 String          @id @default(uuid()) @db.Uuid
  stationId          String          @map("station_id") @db.Uuid
  code               String
  type               CabinType
  occupancyStatus    OccupancyStatus @default(free) @map("occupancy_status")
  isPaid             Boolean         @map("is_paid")
  priceAmount        Decimal?        @map("price_amount") @db.Decimal(10, 2)
  priceCurrency      String?         @map("price_currency")
  lastStatusChangeAt DateTime?       @map("last_status_change_at")

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  /// Sanctioned Operations read dependency, same as Station.telemetryReadings.
  telemetryReadings TelemetryReading[]
  /// Sanctioned Access & Payment command dependency (module-dependency-diagram.md
  /// §3: `AccessPay -> StationNet` plain ✔) — ERD §3.10.
  accessSessions    AccessSession[]

  @@unique([stationId, code])
  /// ERD §5 "idx_cabin_occupancy_status" — FR-PLC-02 real-time availability lookups.
  @@index([occupancyStatus])
  @@map("cabin")
}

/// ERD §3.3 — at most one per Station.
model SlatokiTent {
  id                String                      @id @default(uuid()) @db.Uuid
  stationId         String                      @unique @map("station_id") @db.Uuid
  deploymentStatus  SlatokiTentDeploymentStatus @map("deployment_status")
  matCapacity       Int                         @map("mat_capacity")
  hasLighting       Boolean                     @map("has_lighting")
  hasPrivacyCurtain Boolean                     @map("has_privacy_curtain")
  lastUpdatedAt     DateTime                    @default(now()) @map("last_updated_at")

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@map("slatoki_tent")
}

// --- Third-Party Places bounded context (docs/architecture/domain-model.md §5) ---

/// ERD §3.4 — aggregate root. `position` — see the Station model's note on Unsupported geography columns.
model ThirdPartyPlace {
  id             String                                @id @default(uuid()) @db.Uuid
  nameFr         String                                @map("name_fr")
  nameAr         String                                @map("name_ar")
  placeType      PlaceType                             @map("place_type")
  position       Unsupported("geography(Point, 4326)")
  isFree         Boolean                               @map("is_free")
  priceAmount    Decimal?                              @map("price_amount") @db.Decimal(10, 2)
  priceCurrency  String?                               @map("price_currency")
  declaredStatus DeclaredStatus                        @map("declared_status")
  statusSource   StatusSource                          @map("status_source")
  createdAt      DateTime                              @default(now()) @map("created_at")
  updatedAt      DateTime                              @updatedAt @map("updated_at")

  tags ThirdPartyPlaceTag[]

  /// ERD §5 "idx_place_type".
  @@index([placeType])
  @@map("third_party_place")
}

/// ERD §3.5 — lookup table for the 5 fixed tag codes. Seeded, not user-editable via API.
model Tag {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  labelFr String @map("label_fr")
  labelAr String @map("label_ar")

  places ThirdPartyPlaceTag[]

  @@map("tag")
}

/// ERD §3.6 — M:N join between ThirdPartyPlace and Tag.
model ThirdPartyPlaceTag {
  thirdPartyPlaceId String   @map("third_party_place_id") @db.Uuid
  tagId             String   @map("tag_id") @db.Uuid
  appliedAt         DateTime @default(now()) @map("applied_at")

  thirdPartyPlace ThirdPartyPlace @relation(fields: [thirdPartyPlaceId], references: [id], onDelete: Cascade)
  tag             Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([thirdPartyPlaceId, tagId])
  @@map("third_party_place_tag")
}

enum StationConfiguration {
  fixe
  mobile
  event
}

enum StationStatus {
  active
  inactive
  maintenance
}

enum CabinType {
  H
  F
  Slatoki
  PMR
}

enum OccupancyStatus {
  free
  occupied
  out_of_service
}

enum SlatokiTentDeploymentStatus {
  deployed
  folded
}

enum PlaceType {
  mosque
  business
  gas_station
  other
}

enum DeclaredStatus {
  open
  closed
  unknown
}

enum StatusSource {
  community
  owner_declared
}

enum PreferredLanguage {
  fr
  ar
}

enum DiabeticVerificationStatus {
  none
  pending
  verified
  rejected
}

// --- Notifications bounded context (docs/architecture/domain-model.md §8) ---

/// ERD §3.14 — aggregate root. `relatedAlertId`/`relatedTransactionId` carry
/// no `@relation` — Alert (Operations) and Transaction (Access & Payment)
/// don't exist yet (both bounded contexts are out of scope for this pass,
/// same precedent as Favorite/Review's dangling FKs when Station/ThirdPartyPlace
/// didn't exist yet).
///
/// `isRead`/`readAt` are NOT in the ERD — an additive gap-fill confirmed with
/// the user (Notifications module kickoff, 2026-08-05): openapi.yaml defines
/// `PATCH /users/me/notifications/{id}` as "Mark a notification as read" but
/// neither the ERD, domain-model.md, nor the OpenAPI Notification response
/// schema had ever modeled a read/unread concept at all. See
/// docs/phase-4-implementation-plan.md for the full writeup.
model Notification {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String?             @map("user_id") @db.Uuid
  channel              NotificationChannel
  type                 NotificationType
  relatedAlertId       String?             @map("related_alert_id") @db.Uuid
  relatedTransactionId String?             @map("related_transaction_id") @db.Uuid
  status               NotificationStatus  @default(queued)
  isRead               Boolean             @default(false) @map("is_read")
  readAt               DateTime?           @map("read_at")
  createdAt            DateTime            @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // GET /users/me/notifications lists by user_id; no pagination in the
  // contract (flagged — see Phase 4 Implementation Plan), but every list
  // query still needs this index to avoid a full table scan.
  @@index([userId])
  @@map("notification")
}

enum NotificationChannel {
  push
  in_app
}

enum NotificationType {
  availability
  operator_alert
  payment_confirmation
}

enum NotificationStatus {
  queued
  sent
  delivered
  failed
}

// --- Operations bounded context (docs/architecture/domain-model.md §10) ---

/// ERD §3.11 — aggregate root. `type` mirrors FR-OPS-02's priority order.
/// `onDelete: Restrict` on `station` — ERD §4 "RESTRICT (preserve audit trail)".
model Alert {
  id             String        @id @default(uuid()) @db.Uuid
  stationId      String        @map("station_id") @db.Uuid
  type           AlertType
  severity       AlertSeverity
  status         AlertStatus   @default(open)
  acknowledgedBy String?       @map("acknowledged_by") @db.Uuid
  raisedAt       DateTime      @default(now()) @map("raised_at")
  resolvedAt     DateTime?     @map("resolved_at")

  station       Station                   @relation(fields: [stationId], references: [id], onDelete: Restrict)
  interventions MaintenanceIntervention[]

  /// ERD §5 "idx_alert_station_status" / "idx_alert_severity_status" — the
  /// prioritized queue (FR-OPS-02) filters by status and sorts by severity.
  @@index([stationId, status])
  @@index([severity, status])
  @@map("alert")
}

/// ERD §3.12 [NEW] — separate aggregate from Alert (Domain Model §10),
/// optionally linked to the Alert that triggered it; may also be scheduled
/// preventively with no triggering alert. `onDelete: Restrict` on `station`
/// — ERD §4 "RESTRICT".
model MaintenanceIntervention {
  id               String             @id @default(uuid()) @db.Uuid
  stationId        String             @map("station_id") @db.Uuid
  alertId          String?            @map("alert_id") @db.Uuid
  interventionType InterventionType   @map("intervention_type")
  status           InterventionStatus @default(scheduled)
  assignedTo       String             @map("assigned_to") @db.Uuid
  scheduledAt      DateTime           @map("scheduled_at")
  completedAt      DateTime?          @map("completed_at")

  station Station @relation(fields: [stationId], references: [id], onDelete: Restrict)
  alert   Alert?  @relation(fields: [alertId], references: [id])

  @@index([stationId])
  @@map("maintenance_intervention")
}

/// ERD §3.13 [NEW] — supports FR-CLD-01/8 (capteurs) and, via its `occupancy`
/// metric, FR-OPS-04's per-station history. NOT explicitly assigned to a
/// bounded context in domain-model.md's 10 contexts (flagged documentation
/// gap — same treatment as Review/Favorite's Phase-0-vs-ERD gap noted in
/// Phase 4 Implementation Plan §12). Modeled here because its only documented
/// consumer endpoint (`GET /ops/stations/{id}/occupancy-history`) is tagged
/// Operations; ADR-0013 ties it directly to FR-OPS-04. Read-only in this
/// pass — see domain/ports/telemetry-reading.repository.ts for why no write
/// path exists yet. ADR-0013's native declarative range partitioning
/// (monthly, on `recorded_at`) is not expressible in Prisma's schema
/// language — documented in prisma/README.md for the first real migration,
/// same treatment as the GIST spatial indexes.
model TelemetryReading {
  id         String          @id @default(uuid()) @db.Uuid
  stationId  String          @map("station_id") @db.Uuid
  /// Nullable — ERD §3.13: "station-level readings have no cabin". The
  /// `occupancy` metric (FR-OPS-04 series) is always station-level (null) —
  /// see the port doc comment for why a per-cabin fan-out isn't modeled here.
  cabinId    String?         @map("cabin_id") @db.Uuid
  metric     TelemetryMetric
  value      Decimal         @db.Decimal(10, 2)
  recordedAt DateTime        @map("recorded_at")

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  cabin   Cabin?  @relation(fields: [cabinId], references: [id], onDelete: Cascade)

  /// Composite index (station_id, recorded_at) — ADR-0013's stated query-performance
  /// mechanism for time-bounded reads, alongside partition pruning once partitioned.
  @@index([stationId, metric, recordedAt])
  @@map("telemetry_reading")
}

enum AlertType {
  fire
  sos
  technical_anomaly
  preventive_maintenance
}

enum AlertSeverity {
  critical
  high
  medium
  low
}

enum AlertStatus {
  open
  acknowledged
  in_progress
  resolved
}

enum InterventionType {
  refill
  emptying
  repair
  preventive
}

enum InterventionStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum TelemetryMetric {
  battery_level
  water_level
  door_sensor
  occupancy
}

// --- Access & Payment bounded context (docs/architecture/domain-model.md §6) ---

/// ERD §3.10 — aggregate root of the Access & Payment bounded context (Domain
/// Model §6): "models RAH-DOC-005 §2.5 steps 1-3 (scan -> availability check
/// -> payment-or-direct-access) as a distinct lifecycle from Transaction,
/// because a free-access session produces no transaction row". `onDelete:
/// Restrict` on `cabin`/`user` — same "preserve audit trail" treatment as
/// Alert/MaintenanceIntervention's Station relation (ERD §4).
model AccessSession {
  id            String              @id @default(uuid()) @db.Uuid
  cabinId       String              @map("cabin_id") @db.Uuid
  userId        String?             @map("user_id") @db.Uuid
  status        AccessSessionStatus @default(initiated)
  qrCodeScanned String              @map("qr_code_scanned")
  startedAt     DateTime            @default(now()) @map("started_at")
  unlockedAt    DateTime?           @map("unlocked_at")
  closedAt      DateTime?           @map("closed_at")

  cabin       Cabin        @relation(fields: [cabinId], references: [id], onDelete: Restrict)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction Transaction?

  /// ERD §3.10 "idx_access_session_cabin_status" — real-time cabin status queries (FR-PAY-05).
  @@index([cabinId, status])
  @@map("access_session")
}

/// ERD §3.10 — "Identifiant, utilisateur, cabine/lieu, montant, statut,
/// horodatage" (§8). `discountApplied` persists the Mode Urgence 50%
/// discount (FR-EMG-03). `onDelete: Restrict` on `user` — same audit-trail
/// treatment as AccessSession; `paymentMethod` uses `SetNull` since a
/// deleted payment method should not block deleting/retaining the
/// transaction record itself.
model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  accessSessionId String?           @unique @map("access_session_id") @db.Uuid
  paymentMethodId String?           @map("payment_method_id") @db.Uuid
  amount          Decimal           @db.Decimal(10, 2)
  currency        String            @default("DZD")
  discountApplied Decimal?          @map("discount_applied") @db.Decimal(5, 2)
  status          TransactionStatus @default(pending)
  providerRef     String?           @map("provider_ref")
  createdAt       DateTime          @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  accessSession AccessSession? @relation(fields: [accessSessionId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  /// ERD §3.10 "idx_transaction_user_id".
  @@index([userId])
  @@map("transaction")
}

/// Additive gap-fill (not in the ERD) — backs the `Idempotency-Key` header
/// contract for `POST /access-sessions` and `POST /access-sessions/{id}/payments`
/// (api-architecture.md §8, Risk Register R-11/R-12): deduplicates on
/// `(user, key, endpoint)` so a client retry never double-charges or
/// double-creates a session. Same treatment as Notification's `isRead`/`readAt`
/// additive gap-fill — flagged here, not silently invented against the ERD.
model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String
  endpoint       String
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, key, endpoint])
  @@map("idempotency_key")
}

enum AccessSessionStatus {
  initiated
  payment_pending
  unlocked
  in_use
  completed
  cancelled
}

enum TransactionStatus {
  pending
  authorized
  captured
  failed
  refunded
}
