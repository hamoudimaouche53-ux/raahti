// RAHATI API Backend — Prisma schema.
// Canonical, generated-from, single definition of the relational schema, kept in
// 1:1 correspondence with the ERD (docs/erd/erd.md) per System Architecture §7.
// Built incrementally, module by module (Phase 4 Implementation Plan §7) — only
// entities needed by modules implemented so far are present.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// postgis: backs the Unsupported("geography(Point, 4326)") columns below
// (Station.position, ThirdPartyPlace.position) — System Architecture §7,
// ADR-0012. `previewFeatures = ["postgresqlExtensions"]` is required for
// Prisma to manage the extension in a real migration; not exercised here,
// no live database is provisioned yet (see prisma/README.md).
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// --- Identity & Access bounded context (docs/architecture/domain-model.md §2) ---

/// ERD §3.7 — lookup table for the 4 fixed RBAC roles. Seeded, not user-editable via API.
model Role {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique // usager | operateur | sponsor | admin
  labelFr String @map("label_fr")
  labelAr String @map("label_ar")

  userRoles UserRole[]

  @@map("role")
}

/// ERD §3.6 — aggregate root of the Identity & Access bounded context (Domain Model §2).
/// Guest usage (no account) is represented by the absence of a User row entirely, per
/// FR-USR-01 — this table only ever holds account-holding users.
model User {
  /// Supabase Auth `sub` claim, not a DB-generated UUID — see ADR-0028. Always
  /// supplied explicitly by the application (JIT provisioning), never defaulted.
  id                         String                     @id @db.Uuid
  email                      String?                    @unique
  phone                      String?                    @unique
  preferredLanguage          PreferredLanguage          @default(fr) @map("preferred_language")
  diabeticVerificationStatus DiabeticVerificationStatus @default(none) @map("diabetic_verified_status")
  isActive                   Boolean                    @default(true) @map("is_active")
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")

  roles                    UserRole[]
  verificationDocuments    VerificationDocument[] @relation("VerificationDocumentOwner")
  reviewedVerificationDocs VerificationDocument[] @relation("VerificationDocumentReviewer")
  paymentMethods           PaymentMethod[]
  favorites                Favorite[]
  reviews                  Review[]

  @@map("user_account")
}

/// ERD §3.7 — grants a Role to a User, optionally scoped to a site (multi-site operateur, §4).
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  siteScope String?  @map("site_scope")
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, siteScope])
  @@map("user_role")
}

/// ERD §3.9 — data shape of the diabetic-verification submission workflow. Clinical
/// verification logic itself is out of scope (ADR-0010, deferred to health-partner
/// discussions) — this model only tracks submission/review state. Transition
/// invariant (pending -> approved/rejected, never backward) is enforced in
/// domain/entities/verification-document.entity.ts, not at the DB layer.
model VerificationDocument {
  id           String                   @id @default(uuid()) @db.Uuid
  userId       String                   @map("user_id") @db.Uuid
  documentType String                   @map("document_type") // diabetic_certificate
  storageRef   String                   @map("storage_ref")
  reviewStatus VerificationReviewStatus @default(pending) @map("review_status")
  reviewedBy   String?                  @map("reviewed_by") @db.Uuid
  submittedAt  DateTime                 @default(now()) @map("submitted_at")
  reviewedAt   DateTime?                @map("reviewed_at")

  user     User  @relation("VerificationDocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("VerificationDocumentReviewer", fields: [reviewedBy], references: [id])

  @@map("verification_document")
}

/// ERD entity referenced by RAH-DOC-005 §2.6 "moyens de paiement" — provider-tokenized
/// only (ADR-0014, NFR-SEC-03), never raw card data.
model PaymentMethod {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  methodType  String   @map("method_type") // card | mobile_wallet | subscription
  providerRef String   @map("provider_ref")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_method")
}

/// ERD §3.16 — polymorphic over Station XOR ThirdPartyPlace (same pattern as Review,
/// ERD §3.15). The CHECK constraint enforcing "exactly one of stationId/
/// thirdPartyPlaceId is non-null" is not expressible in Prisma's schema language —
/// added via a hand-written SQL migration once a live database is available to run
/// `prisma migrate dev` against (none is provisioned yet — ADR-0016 hosting is still
/// Proposed). The same invariant is enforced in domain/entities/favorite.entity.ts
/// as the primary guard until then. `stationId`/`thirdPartyPlaceId` do not carry a
/// Prisma `@relation` yet — Station/ThirdPartyPlace models don't exist until the
/// facilities module (Phase 4 Implementation Plan §6 item 3) is implemented.
model Favorite {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  stationId         String?  @map("station_id") @db.Uuid
  thirdPartyPlaceId String?  @map("third_party_place_id") @db.Uuid
  notifyOnAvailable Boolean  @default(false) @map("notify_on_available")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevents a user from favoriting the same station (or same third-party place)
  // twice. Nullable-column unique indexes: Postgres treats each NULL as distinct,
  // so these correctly scope the dedup to same-kind favorites only.
  @@unique([userId, stationId])
  @@unique([userId, thirdPartyPlaceId])
  @@map("favorite")
}

/// ERD §3.15 — polymorphic over Station XOR ThirdPartyPlace, same pattern as
/// Favorite (§3.16). Not "owned" by either bounded-context module in the
/// domain sense — StationNetworkModule and ThirdPartyPlacesModule each keep
/// their own independent Review domain entity + repository port, both
/// backed by this single shared table (each scoped to its own non-null FK
/// column), per ADR-0029's "read composition only, writes stay in their
/// owning context" rule. The XOR CHECK constraint is not expressible in
/// Prisma's schema language — see prisma/README.md for the deferred SQL
/// migration (same situation as Favorite).
model Review {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  stationId         String?  @map("station_id") @db.Uuid
  thirdPartyPlaceId String?  @map("third_party_place_id") @db.Uuid
  rating            Int
  comment           String?
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // stationId/thirdPartyPlaceId carry no `@relation` (see the module note
  // above), so Prisma's automatic FK-scalar indexing doesn't apply to them —
  // both are queried directly (rating-aggregation WHERE/JOIN/GROUP BY in
  // Facilities Pass 4's searchNearby and getRatingAggregate), so both need
  // an explicit index.
  @@index([stationId])
  @@index([thirdPartyPlaceId])
  @@map("review")
}

enum VerificationReviewStatus {
  pending
  approved
  rejected
}

// --- Station Network bounded context (docs/architecture/domain-model.md §3) ---

/// ERD §3.1 — aggregate root (Domain Model §3). `position` is PostGIS
/// geography(Point,4326) — Prisma's query builder can't express ST_DWithin/
/// ST_Distance (ADR-0012), so it's declared `Unsupported` for schema/migration
/// parity with the ERD and read/written exclusively via $queryRaw/$executeRaw
/// (see infrastructure/prisma-station.repository.ts).
model Station {
  id                 String                                @id @default(uuid()) @db.Uuid
  code               String                                @unique
  configuration      StationConfiguration
  position           Unsupported("geography(Point, 4326)")
  status             StationStatus
  cabinCapacity      Int                                   @map("cabin_capacity")
  tankCapacityLiters Int                                   @map("tank_capacity_liters")
  installedAt        DateTime                              @map("installed_at")
  createdAt          DateTime                              @default(now()) @map("created_at")
  updatedAt          DateTime                              @updatedAt @map("updated_at")

  cabins      Cabin[]
  slatokiTent SlatokiTent?

  /// ERD §5 "idx_station_status" — searchNearby (Facilities Pass 3) filters
  /// on status = 'active'; also supports FR-OPS-01 fleet filtering.
  @@index([status])
  @@map("station")
}

/// ERD §3.2 — entity within the Station aggregate.
model Cabin {
  id                 String          @id @default(uuid()) @db.Uuid
  stationId          String          @map("station_id") @db.Uuid
  code               String
  type               CabinType
  occupancyStatus    OccupancyStatus @default(free) @map("occupancy_status")
  isPaid             Boolean         @map("is_paid")
  priceAmount        Decimal?        @map("price_amount") @db.Decimal(10, 2)
  priceCurrency      String?         @map("price_currency")
  lastStatusChangeAt DateTime?       @map("last_status_change_at")

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, code])
  /// ERD §5 "idx_cabin_occupancy_status" — FR-PLC-02 real-time availability lookups.
  @@index([occupancyStatus])
  @@map("cabin")
}

/// ERD §3.3 — at most one per Station.
model SlatokiTent {
  id                String                      @id @default(uuid()) @db.Uuid
  stationId         String                      @unique @map("station_id") @db.Uuid
  deploymentStatus  SlatokiTentDeploymentStatus @map("deployment_status")
  matCapacity       Int                         @map("mat_capacity")
  hasLighting       Boolean                     @map("has_lighting")
  hasPrivacyCurtain Boolean                     @map("has_privacy_curtain")
  lastUpdatedAt     DateTime                    @default(now()) @map("last_updated_at")

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@map("slatoki_tent")
}

// --- Third-Party Places bounded context (docs/architecture/domain-model.md §5) ---

/// ERD §3.4 — aggregate root. `position` — see the Station model's note on Unsupported geography columns.
model ThirdPartyPlace {
  id             String                                @id @default(uuid()) @db.Uuid
  nameFr         String                                @map("name_fr")
  nameAr         String                                @map("name_ar")
  placeType      PlaceType                             @map("place_type")
  position       Unsupported("geography(Point, 4326)")
  isFree         Boolean                               @map("is_free")
  priceAmount    Decimal?                              @map("price_amount") @db.Decimal(10, 2)
  priceCurrency  String?                               @map("price_currency")
  declaredStatus DeclaredStatus                        @map("declared_status")
  statusSource   StatusSource                          @map("status_source")
  createdAt      DateTime                              @default(now()) @map("created_at")
  updatedAt      DateTime                              @updatedAt @map("updated_at")

  tags ThirdPartyPlaceTag[]

  /// ERD §5 "idx_place_type".
  @@index([placeType])
  @@map("third_party_place")
}

/// ERD §3.5 — lookup table for the 5 fixed tag codes. Seeded, not user-editable via API.
model Tag {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  labelFr String @map("label_fr")
  labelAr String @map("label_ar")

  places ThirdPartyPlaceTag[]

  @@map("tag")
}

/// ERD §3.6 — M:N join between ThirdPartyPlace and Tag.
model ThirdPartyPlaceTag {
  thirdPartyPlaceId String   @map("third_party_place_id") @db.Uuid
  tagId             String   @map("tag_id") @db.Uuid
  appliedAt         DateTime @default(now()) @map("applied_at")

  thirdPartyPlace ThirdPartyPlace @relation(fields: [thirdPartyPlaceId], references: [id], onDelete: Cascade)
  tag             Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([thirdPartyPlaceId, tagId])
  @@map("third_party_place_tag")
}

enum StationConfiguration {
  fixe
  mobile
  event
}

enum StationStatus {
  active
  inactive
  maintenance
}

enum CabinType {
  H
  F
  Slatoki
  PMR
}

enum OccupancyStatus {
  free
  occupied
  out_of_service
}

enum SlatokiTentDeploymentStatus {
  deployed
  folded
}

enum PlaceType {
  mosque
  business
  gas_station
  other
}

enum DeclaredStatus {
  open
  closed
  unknown
}

enum StatusSource {
  community
  owner_declared
}

enum PreferredLanguage {
  fr
  ar
}

enum DiabeticVerificationStatus {
  none
  pending
  verified
  rejected
}
