# infra/osrm environment — copy to `.env` in this directory for local use.
# Never commit the real `.env` (repo-root .gitignore already covers this).
# Consumed by docker-compose.yml and scripts/*.sh.

# Which region's dataset to load — must match the basename produced by
# scripts/preprocess.sh (default "algeria" -> data/current/algeria-latest.osrm*).
OSRM_REGION=algeria

# Where processed OSRM data + the raw downloaded .pbf live. Defaults to
# ./data (this directory, gitignored). On a real server, point this at a
# persistent volume/disk path outside the repo checkout entirely, e.g.
# OSRM_DATA_DIR=/var/lib/rahati-osrm
OSRM_DATA_DIR=./data

# Host port osrm-routed is published on. Change if 5000 is already in use.
OSRM_HOST_PORT=5000

# Interface the host port is bound to. 127.0.0.1 = only reachable from the
# same machine (correct when the RAHATI backend runs on the same host, or
# reaches this over a private Docker network — see README.md "Networking").
# Only widen this (e.g. to a private-network IP) if backend and OSRM are on
# separate hosts — never set to 0.0.0.0 on a host with a public IP.
OSRM_BIND_ADDRESS=127.0.0.1

# Geofabrik source URL for scripts/download-data.sh — official/reputable
# extract provider used throughout the OSM/OSRM ecosystem. Change only if
# switching region (must then also update OSRM_REGION and the path below to
# match Geofabrik's directory structure, e.g. europe/france for France).
OSRM_PBF_URL=https://download.geofabrik.de/africa/algeria-latest.osm.pbf
